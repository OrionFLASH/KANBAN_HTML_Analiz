  "manager_analytics": {
    "enabled": true,
    "metric": "days_on_stage",
    "percentile": 80,
    "threshold_scope": "overall",
    "top_managers_per_tb": 3,
    "top_hotspots_per_manager": 5,
    "top_stuck_items_per_hotspot": 15,
    "use_latest_report_date": true,
    "html_include_detail": false,
    "rank_by_team": true,
    "team_files": {
