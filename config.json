  "dashboard": {
    "all_tb_label": "__ALL__",
    "all_tb_display": "ВСЕ ТБ",
    "default_tb": "__ALL__",
    "default_metric": "days_on_stage",
    "default_indicator": "p80",
    "excel_max_chart_series": 8,
    "max_chart_series": 12,
    "precompute_html_filter_slices": true,
    "show_managers_tab": true,
