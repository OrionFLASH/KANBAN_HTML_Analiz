  "duration_source": "columns",
  "stage_analysis_mode": "status",
  "product_analysis_mode": "group_product",
  "percentiles": [20, 50, 80],
  "stages_order": [
    "К ПРОДАЖЕ",
    "ВЫЯВЛЕНИЕ ПОТРЕБНОСТИ",
