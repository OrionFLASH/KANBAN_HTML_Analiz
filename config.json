    "Канбан СРБ (К ПРОДАЖЕ) все на 27-08-2026.xlsx",
    "Канбан СибБ (К ПРОДАЖЕ) все на 27-08-2026.xlsx",
    "Канбан СЗБ (К ПРОДАЖЕ) все на 27-08-2026.xlsx",
    "Канбан ПБ (К ПРОДАЖЕ) все на 27-08-2026.xlsx",
    "Канбан МБ (К ПРОДАЖЕ) все на 27-08-2026.xlsx",
    "Канбан ДВБ (К ПРОДАЖЕ) все на 27-08-2026.xlsx",
    "Канбан ВВБ (К ПРОДАЖЕ) все на 27-08-2026.xlsx",
